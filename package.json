{
  "name": "bms",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test 'tests/*.test.ts'",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "test:all": "npm test && npm run test:integration",
    "test:api": "tsx scripts/test-all-apis.ts",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:outlets": "tsx prisma/seeds/01-outlets.ts",
    "seed:users": "tsx prisma/seeds/02-users.ts",
    "seed:inventory": "tsx prisma/seeds/03-inventory.ts",
    "seed:demo": "tsx prisma/seeds/04-demo-data.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@tailwindcss/postcss": "^4.3.5",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.3",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8",
    "prisma": "^5.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
